<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Kotodo" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- The app bar goes darker rather than lighter, so it recedes on dark. -->
        <item name="colorPrimary">@color/slate_800</item>
        <item name="colorPrimaryVariant">@color/slate_900</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- A lighter 朱 keeps the accent readable against the dark surface. -->
        <item name="colorSecondary">@color/vermilion_300</item>
        <item name="colorSecondaryVariant">@color/vermilion_300</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!--
          Theme.Kotodo is redefined wholesale in this file (Android does not merge
          the light and night versions of the same style name), so this pointer has
          to be repeated here even though Theme.Kotodo.AlertDialog itself is only
          declared once, in values/themes.xml.
        -->
        <item name="alertDialogTheme">@style/Theme.Kotodo.AlertDialog</item>
    </style>
</resources>
