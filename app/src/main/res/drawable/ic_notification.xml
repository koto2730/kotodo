<?xml version="1.0" encoding="utf-8"?>
<!--
  Status bar icon: the same tick-and-line mark as the launcher, so the app is
  recognisable in the shade. Must be a white-on-transparent silhouette - Android
  tints it and ignores the colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:pathData="M4,11.5 L9,16.5 L20,5.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.6" />

    <path
        android:pathData="M3.5,20.5 L20.5,20.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="2.2" />
</vector>
