<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android 12 backup rules: Kotodo's data never goes to cloud backup. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
