<?xml version="1.0" encoding="utf-8"?>
<!--
  The languages Kotodo ships translations for. Declaring them lets Android 13+
  show a per-app language picker under Settings > Apps > Kotodo > Language, on
  top of the automatic switch that follows the device language.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ja" />
</locale-config>
