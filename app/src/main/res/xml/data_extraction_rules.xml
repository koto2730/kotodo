<?xml version="1.0" encoding="utf-8"?>
<!--
  Kotodo keeps everything on the device. Cloud backup is switched off (see also
  android:allowBackup="false" in the manifest); the explicit excludes keep it off
  even if allowBackup is ever flipped. Device-to-device transfer is left at its
  default so moving to a new phone still carries the todos over.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
