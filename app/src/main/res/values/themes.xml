<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Kotodo" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- 鉄紺: near-neutral chrome that lets the priority stripes carry the colour. -->
        <item name="colorPrimary">@color/slate_600</item>
        <item name="colorPrimaryVariant">@color/slate_800</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- 朱: the single accent, used by the add button, checkboxes and switches. -->
        <item name="colorSecondary">@color/vermilion_600</item>
        <item name="colorSecondaryVariant">@color/vermilion_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Dialog action buttons ("OK", "Delete"...) get the 朱 accent instead of
             the default colorPrimary - see Theme.Kotodo.AlertDialog below. -->
        <item name="alertDialogTheme">@style/Theme.Kotodo.AlertDialog</item>
    </style>

    <!--
      Material's default AlertDialog styling colours the action buttons with
      colorPrimary. That is our near-neutral 鉄紺 chrome colour, which reads fine
      on the light theme's white dialog background but nearly disappears against
      the dark theme's dark dialog surface. Buttons are things you act on, so they
      get the same 朱 accent as the FAB, checkboxes and switches instead.
      ?attr/colorSecondary (not a literal colour) so this single style adapts to
      whichever Theme.Kotodo - light or night - is asking for it.
    -->
    <style name="Theme.Kotodo.AlertDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">?attr/colorSecondary</item>
        <item name="colorAccent">?attr/colorSecondary</item>
    </style>

    <style name="Theme.Kotodo.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Kotodo.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.Kotodo.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- Small caps-style heading used between form and filter sections. -->
    <style name="Kotodo.SectionLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textAppearance">?attr/textAppearanceOverline</item>
        <!-- A dedicated colour, not ?attr/colorPrimary: the primary is a dark
             slate that would vanish against the dark theme background. -->
        <item name="android:textColor">@color/section_label</item>
    </style>
</resources>
