<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Kotodo" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- 鉄紺: near-neutral chrome that lets the priority stripes carry the colour. -->
        <item name="colorPrimary">@color/slate_600</item>
        <item name="colorPrimaryVariant">@color/slate_800</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- 朱: the single accent, used by the add button, checkboxes and switches. -->
        <item name="colorSecondary">@color/vermilion_600</item>
        <item name="colorSecondaryVariant">@color/vermilion_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Dialog action buttons ("OK", "Delete"...) get the 朱 accent instead of
             the default colorPrimary - see Theme.Kotodo.AlertDialog below. -->
        <item name="colorControlActivated">?attr/colorSecondary</item>
        <item name="textInputStyle">@style/Widget.Kotodo.TextInputLayout.OutlinedBox</item>
        <item name="alertDialogTheme">@style/Theme.Kotodo.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/Theme.Kotodo.AlertDialog</item>
        <item name="materialCalendarTheme">@style/ThemeOverlay.Kotodo.MaterialCalendar</item>
        <item name="materialTimePickerTheme">@style/ThemeOverlay.Kotodo.MaterialTimePicker</item>
    </style>

    <!--
      Material's default AlertDialog, MaterialDatePicker, and MaterialTimePicker
      styling colours the action buttons with colorPrimary. That is our near-neutral
      鉄紺 chrome colour, which reads fine on the light theme's white dialog
      background but nearly disappears against the dark theme's dark dialog surface.
      Buttons are things you act on, so they get the same 朱 accent as the FAB,
      checkboxes and switches instead.
    -->
    <style name="Widget.Kotodo.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/colorSecondary</item>
    </style>

    <style name="Theme.Kotodo.AlertDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">?attr/colorSecondary</item>
        <item name="colorAccent">?attr/colorSecondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Kotodo.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Kotodo.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Kotodo.DialogButton</item>
    </style>

    <style name="ThemeOverlay.Kotodo.MaterialCalendar" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorPrimary">?attr/colorSecondary</item>
        <item name="colorOnPrimary">?attr/colorOnSecondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Kotodo.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Kotodo.DialogButton</item>
    </style>

    <style name="ThemeOverlay.Kotodo.MaterialTimePicker" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <item name="colorPrimary">?attr/colorSecondary</item>
        <item name="colorOnPrimary">?attr/colorOnSecondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Kotodo.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Kotodo.DialogButton</item>
    </style>

    <!--
      Buttons. The stock Material styles colour text buttons with colorPrimary, which is
      the near-neutral 鉄紺 chrome colour - fine on white, but on the dark theme it is
      almost the surface colour and the caption disappears. These two styles read their
      colours from theme attributes, so one definition serves both light and night.
      Text buttons use the plain on-surface colour; the one primary action per screen
      uses the 朱 accent.
    -->
    <style name="Widget.Kotodo.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="rippleColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.Kotodo.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">?attr/colorSecondary</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
    </style>

    <!--
      Text input boxes. Stock Material OutlinedBox uses ?attr/colorPrimary for the
      focused border and floating hint label, which in dark mode is @color/slate_800
      (#263238) and disappears against the dark sheet/screen surface. Using a dedicated
      stroke selector (vermilion accent when focused, readable slate when unfocused)
      keeps the box clearly visible in both light and dark modes.
    -->
    <style name="Widget.Kotodo.TextInputLayout.OutlinedBox" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="hintTextColor">?attr/colorSecondary</item>
        <item name="android:textColorHint">@color/meta_text</item>
    </style>

    <style name="Widget.Kotodo.TextInputLayout.OutlinedBox.ExposedDropdownMenu" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="hintTextColor">?attr/colorSecondary</item>
        <item name="android:textColorHint">@color/meta_text</item>
        <item name="endIconTint">@color/section_label</item>
    </style>

    <style name="Theme.Kotodo.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Kotodo.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.Kotodo.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light">
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
    </style>

    <!-- Small caps-style heading used between form and filter sections. -->
    <style name="Kotodo.SectionLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textAppearance">?attr/textAppearanceOverline</item>
        <!-- A dedicated colour, not ?attr/colorPrimary: the primary is a dark
             slate that would vanish against the dark theme background. -->
        <item name="android:textColor">@color/section_label</item>
    </style>
</resources>
