<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="560dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_filter_sort"
            android:textAppearance="?attr/textAppearanceHeadline6" />

        <TextView
            style="@style/Kotodo.SectionLabel"
            android:text="@string/filter_time" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chips_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/Kotodo.SectionLabel"
            android:text="@string/filter_priority" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chips_priority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/label_group"
            style="@style/Kotodo.SectionLabel"
            android:text="@string/filter_group" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chips_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/Kotodo.SectionLabel"
            android:text="@string/sort_by" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chips_sort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_ascending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sort_ascending" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_hide_completed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/filter_hide_completed" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_reset"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:text="@string/action_reset_filters" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
